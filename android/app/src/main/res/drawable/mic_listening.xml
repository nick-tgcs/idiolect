<?xml version="1.0" encoding="utf-8"?>
<!-- Listening mic: an accent disc inside a soft accent glow halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/idiolect_accent_glow" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/idiolect_accent" />
        </shape>
    </item>
</layer-list>
