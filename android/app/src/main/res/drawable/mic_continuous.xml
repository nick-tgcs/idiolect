<?xml version="1.0" encoding="utf-8"?>
<!-- Continuous mic: a live-red disc in a red glow halo — "keeps going, tap to stop". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/idiolect_live_glow" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/idiolect_live" />
        </shape>
    </item>
</layer-list>
