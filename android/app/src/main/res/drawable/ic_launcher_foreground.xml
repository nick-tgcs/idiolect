<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher foreground: the white mic glyph (from ic_mic), centred in the 108dp
  adaptive viewport and scaled to sit inside the ~66dp safe zone so no launcher mask clips it.
  The 24x24 glyph is scaled ×2.4 about its centre (12, 11.5) and translated to the viewport
  centre (54, 54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="12"
        android:pivotY="11.5"
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="42"
        android:translateY="42.5">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5.3c0,3.41 2.72,6.23 6,6.72V21h1.4v-3.28c3.28,-0.48 6,-3.3 6,-6.72H17z" />
    </group>
</vector>
