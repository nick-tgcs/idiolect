<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ship the learning outbox to the user's PC and pull the model back (M5/M6). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation captures the microphone on-device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Scan the PC's pairing QR to enrol without typing the code by hand. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A camera is only needed for the optional QR pairing, not for dictation. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- A mic foreground service holds capture; its notification is user-visible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-return after a reviewed Insert: idiolect re-selects itself as the active IME so the
         mic comes back without a manual keyboard switch. Android won't let an app pick an IME
         without this; it is NOT auto-granted for a sideloaded app — grant it once via
         `adb shell pm grant <pkg> android.permission.WRITE_SECURE_SETTINGS`. Without the grant the
         feature degrades to a one-tap return on the system IME switcher. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Pairing, learning-sync and the model pull default to PINNED HTTPS: the sync server
         presents a persisted self-signed cert and the phone pins its SPKI fingerprint, carried
         out-of-band in the pairing QR and applied by CertPin / applyPinning. The server's
         optional cleartext mode (for deployments already inside a tailnet or a localhost onion
         tunnel, where TLS is redundant) speaks plain http to the user's OWN machine instead;
         targetSdk >= 28 blocks cleartext by default, so we opt in to keep that fallback working.
         This does NOT loosen the public model download: PublicModelTransport enforces https in
         code, independent of this flag. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Idiolect"
        android:usesCleartextTraffic="true">

        <!-- Launcher / onboarding: enable + select the keyboard, grant the mic.
             singleTop so an `idiolect://pair` deep link delivered while setup is already open
             arrives via onNewIntent on the existing instance, not a second copy. -->
        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Camera-free pairing: a tapped/fired idiolect://pair?u=…&amp;c=… link (the same
                 URI the PC pairing QR encodes) drives enrolment without scanning. This is the
                 hermetic, adb-automatable path the emulator e2e fires. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="idiolect" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- The centred "Review dictation" surface (the 👁 flow): a translucent window over
             the host app, edited with the user's own keyboard. Not exported.
             Empty taskAffinity is load-bearing: launched NEW_TASK from the IME service, it must
             NOT join idiolect's own app task (which may have SetupActivity open) — otherwise on
             dismiss it leaves idiolect's app foreground instead of returning to the host app the
             user was dictating into. With no affinity it overlays the host app and returns to it. -->
        <activity
            android:name=".ime.ReviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- The settings screen, opened from the ⚙ on the mic strip (not exported; launched
             only from our own IME). Pairing/unpairing, dictation modes, model, storage. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/settings_title" />

        <!-- The IME itself. BIND_INPUT_METHOD restricts binding to the system. -->
        <service
            android:name=".ime.IdiolectImeService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Holds the microphone (foreground, user-visible) for the duration of a take. -->
        <service
            android:name=".audio.MicForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- "Instant insert": the only API that can type the reviewed correction into the
             user's app while their own keyboard is active (the 👁 flow). Opt-in, user-enabled
             in Accessibility settings; dictation works without it. -->
        <service
            android:name=".accessibility.IdiolectAccessibilityService"
            android:exported="false"
            android:icon="@drawable/ic_mic"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
